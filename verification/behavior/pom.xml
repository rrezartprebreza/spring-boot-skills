<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.rrezart</groupId>
    <artifactId>skill-behavior-verification</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <properties>
        <boot.major>4</boot.major>
        <boot.version>4.1.0</boot.version>
        <web.starter>spring-boot-starter-webmvc</web.starter>
        <flyway.group>org.springframework.boot</flyway.group>
        <flyway.artifact>spring-boot-starter-flyway</flyway.artifact>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${boot.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>${web.starter}</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>${flyway.group}</groupId><artifactId>${flyway.artifact}</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>0.12.6</version></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>0.12.6</version><scope>runtime</scope></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>0.12.6</version><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <!-- Compile the shipped templates, not copies in the test project. -->
        <sourceDirectory>${project.basedir}/../../skills/spring-boot-${boot.major}</sourceDirectory>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource>
                <directory>${project.basedir}/../../skills/spring-boot-${boot.major}/idempotency-patterns/examples</directory>
                <targetPath>fixtures</targetPath>
                <includes><include>good-idempotency.sql</include></includes>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../skills/spring-boot-${boot.major}/flyway-migrations/templates</directory>
                <targetPath>db/migration</targetPath>
                <includes><include>V1__create_table_template.sql</include></includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <includes>
                        <include>spring-security-jwt/templates/*.java</include>
                        <include>problem-details-rfc9457/templates/*.java</include>
                        <include>rest-api-conventions/templates/ApiResponse.java</include>
                        <include>rest-api-conventions/templates/PageResponse.java</include>
                        <include>configuration-properties/examples/ClientProperties.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>boot3</id>
            <properties>
                <boot.major>3</boot.major><boot.version>3.5.16</boot.version>
                <web.starter>spring-boot-starter-web</web.starter>
                <flyway.group>org.flywaydb</flyway.group><flyway.artifact>flyway-core</flyway.artifact>
            </properties>
        </profile>
        <profile><id>boot4</id></profile>
    </profiles>
</project>
